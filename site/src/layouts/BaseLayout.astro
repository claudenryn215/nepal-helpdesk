---
import { SITE } from '../config';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  jsonLd?: object[];
}

const {
  title = SITE.name,
  description = SITE.description,
  canonical = SITE.url + Astro.url.pathname,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      const spans = Array.from(document.querySelectorAll<HTMLElement>('[data-comment-count]'));
      if (spans.length > 0) {
        const byCard = new Map<HTMLElement, string>();
        for (const el of spans) {
          const card = el.closest<HTMLElement>('[data-post-id]');
          if (card?.dataset.postId) byCard.set(el, card.dataset.postId);
        }
        if (byCard.size > 0) {
          const ids = [...new Set(byCard.values())].slice(0, 60);
          fetch(`/api/comments/counts?ids=${encodeURIComponent(ids.join(','))}`)
            .then((res) => (res.ok ? res.json() : null))
            .then((data: { counts?: Record<string, number> } | null) => {
              if (!data?.counts) return;
              for (const [el, id] of byCard) {
                const n = data.counts[id] ?? 0;
                if (n > 0) el.textContent = `${n} comment${n === 1 ? '' : 's'}`;
              }
            })
            .catch(() => {});
        }
      }
    </script>
  </body>
</html>
