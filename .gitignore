# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
site/dist/
site/.astro/

# Runtime state (regenerated by the pipeline).
# These are committed so CI remembers what was published/seen/pending:
!pipeline/state/published.json
!pipeline/state/pending.json
!pipeline/state/seen_ids.json
!pipeline/state/provider-health.json
# Volatile or large state stays ignored:
pipeline/state/raw_posts.jsonl
pipeline/state/reddit_token.json
pipeline/state/trending.json
pipeline/state/verified.json
pipeline/state/drafts.json
pipeline/state/*.json
pipeline/state/*.jsonl
!pipeline/state/.gitkeep

# OS
.DS_Store

# Secrets
.env
.env.*
